{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^vΩ\\d+\\.\\d+$"
    },
    "band": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "witness": {
      "type": "string"
    },
    "identityLock": {
      "type": "boolean"
    },
    "criesWindow": {
      "type": "array"
    },
    "lastClarifier": {
      "type": "boolean"
    },
    "governanceBoost": {
      "type": "boolean"
    },
    "persona": {
      "type": "string",
      "enum": ["Witness", "Auditor", "Architect"]
    },
    "empathy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["version", "band", "witness", "identityLock"],
  "additionalProperties": false
}